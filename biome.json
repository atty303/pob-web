{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "semicolons": "always"
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noUselessElse": "off", "noNonNullAssertion": "off" },
      "a11y": {
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useSemanticElements": "off"
      },
      "correctness": { "useHookAtTopLevel": "off" },
      "suspicious": { "noArrayIndexKey": "off", "useIterableCallbackReturn": "off" }
    }
  }
}
