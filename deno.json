{
  "workspace": [
    "packages/dds",
    "packages/driver",
    "packages/game",
    "packages/packer",
    "packages/web"
  ],
  "nodeModulesDir": "auto",
  "allowScripts": [
    "npm:browser-tabs-lock",
    "npm:core-js",
    "npm:esbuild",
    "npm:workerd"
  ],
  "exclude": [
    ".playwright-mcp",
    "node_modules",
    "vendor",
    "packages/driver/build",
    "packages/driver/dist",
    "packages/driver/.vite",
    "packages/packer/build",
    "packages/packer/r2",
    "packages/web/.wrangler",
    "packages/web/.vite",
    "packages/web/build"
  ],
  "imports": {
    "@auth0/auth0-react": "npm:@auth0/auth0-react@^2.23.0",
    "@bokuweb/zstd-wasm": "npm:@bokuweb/zstd-wasm@^0.0.22",
    "@cloudflare/workers-types": "npm:@cloudflare/workers-types@^5.20260809.1",
    "@cliffy/command": "jsr:@cliffy/command@1.2.1",
    "@david/dax": "jsr:@david/dax@0.49.0",
    "@headlessui/react": "npm:@headlessui/react@^2.2.10",
    "@heroicons/react": "npm:@heroicons/react@^2.2.0",
    "@playwright/mcp": "npm:@playwright/mcp@0.0.79",
    "@playwright/test": "npm:@playwright/test@1.63.0-alpha-2026-08-05",
    "@react-router/dev": "npm:@react-router/dev@^7.18.2",
    "@react-router/fs-routes": "npm:@react-router/fs-routes@^7.18.2",
    "@sentry/react": "npm:@sentry/react@^10.69.0",
    "@sentry/wasm": "npm:@sentry/wasm@^10.69.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "@std/path": "jsr:@std/path@1.1.6",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@^0.5.20",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@types/adm-zip": "npm:@types/adm-zip@^0.5.8",
    "@types/emscripten": "npm:@types/emscripten@^1.41.5",
    "@types/react": "npm:@types/react@^18.3.31",
    "@types/react-dom": "npm:@types/react-dom@^18.3.7",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.2.0",
    "@webgpu/types": "npm:@webgpu/types@^0.1.71",
    "@zenfs/archives": "npm:@zenfs/archives@1.0.5",
    "@zenfs/core": "npm:@zenfs/core@1.11.4",
    "@zenfs/dom": "npm:@zenfs/dom@1.1.5",
    "adm-zip": "npm:adm-zip@^0.6.0",
    "comlink": "npm:comlink@^4.4.1",
    "daisyui": "npm:daisyui@^5.7.16",
    "dayjs": "npm:dayjs@^1.11.21",
    "image-dimensions": "npm:image-dimensions@^2.5.1",
    "isbot": "npm:isbot@^5.2.1",
    "jose": "npm:jose@^5.10.0",
    "missionlog": "npm:missionlog@^1.8.8",
    "react": "npm:react@^18.3.1",
    "react-dom": "npm:react-dom@^18.3.1",
    "react-icons": "npm:react-icons@^5.7.0",
    "react-router": "npm:react-router@^7.18.2",
    "react-use": "npm:react-use@^17.6.1",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@^6.4.3",
    "vite-plugin-inspect": "npm:vite-plugin-inspect@^10.3.0",
    "vite-plugin-static-copy": "npm:vite-plugin-static-copy@^2.3.2",
    "wrangler": "npm:wrangler@^4.120.0"
  },
  "fmt": {
    "exclude": [
      ".agents",
      ".env.pob-cool.yaml",
      ".github/.release-please-manifest.json",
      ".github/workflows",
      "CHANGELOG.md",
      "docs"
    ],
    "lineWidth": 120,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-namespace", "no-sloppy-imports", "no-window", "no-window-prefix", "require-await"]
    }
  },
  "tasks": {
    "playwright": "playwright",
    "playwright-mcp": "playwright-mcp",
    "react-router": "react-router",
    "repo": "deno run --allow-all tools/tasks/main.ts",
    "vite": "vite",
    "wrangler": "wrangler"
  }
}
