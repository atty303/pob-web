{
  "name": "pob-web",
  "private": true,
  "version": "0.28.0",
  "type": "module",
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "@headlessui/react": "^2.2.0",
    "@react-router/node": "^7.18.2",
    "@react-router/fs-routes": "^7.18.2",
    "@sentry/react": "^10.5.0",
    "@heroicons/react": "^2.2.0",
    "isbot": "^5",
    "jose": "^5.3.0",
    "missionlog": "^1.8.8",
    "pob-driver": "*",
    "pob-game": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2",
    "react-use": "^17.6.1",
    "dayjs": "^1.11.13"
  },
  "scripts": {
    "dev": "concurrently \"react-router dev\" \"wrangler pages dev . --compatibility-date=2024-05-11\"",
    "build": "react-router typegen && tsc && react-router build",
    "test:e2e": "playwright test",
    "test:e2e:serve": "react-router dev --mode test --host 127.0.0.1 --port 5174 --strictPort",
    "preview": "react-router preview",
    "deploy": "DEPLOYMENT=cloudflare npm run build && npm run deploy:pages",
    "deploy:pages": "wrangler pages deploy build/client --project-name pob-web"
  }
}
